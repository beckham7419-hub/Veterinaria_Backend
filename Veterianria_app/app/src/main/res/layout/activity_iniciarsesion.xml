<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Iniciarsesion">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/black"
            android:gravity="center"
            >
            <androidx.cardview.widget.CardView
                android:id="@+id/boton_back"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="10dp"
                app:cardCornerRadius="15dp">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@color/white"
                    android:src="@drawable/baseline_arrow_back_24"
                    />
            </androidx.cardview.widget.CardView>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@color/black"
                android:src="@drawable/logo_de_la_veterinaria_transparente"
                />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="35dp"
                android:text="Iniciar sesion"
                android:textStyle="bold"
                android:maxLines="2"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="15sp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_iniciars"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:hint="Ingresa tu usuario:"
                app:helperTextEnabled="true"
                app:helperText="Tu correo electronico"
                app:counterMaxLength="100"
                app:endIconMode="clear_text"
                android:layout_marginBottom="25dp"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_edittext_iniciars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"/>

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_password_in"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:hint="Ingresa tu contraseña:"
                app:helperTextEnabled="true"
                app:helperText="Debe tener al menos 8 caracteres"
                app:counterMaxLength="50"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="25dp"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_edittext_password_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"/>

            </com.google.android.material.textfield.TextInputLayout>
            <Button
                android:id="@+id/iniciarsesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar Sesion"
                android:textStyle="bold"
                android:textSize="15sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
