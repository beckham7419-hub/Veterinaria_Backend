<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vet_bg_outer"
    tools:context=".Registrarse">

    <androidx.cardview.widget.CardView
        android:id="@+id/boton_back2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/vet_card_bg"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@color/black"
            android:gravity="center"
            >
            <androidx.cardview.widget.CardView
                android:id="@+id/boton_back2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="10dp"
                app:cardCornerRadius="15dp">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@color/white"
                    android:src="@drawable/baseline_arrow_back_24"
                    />
            </androidx.cardview.widget.CardView>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@color/black"
                android:src="@drawable/logo_de_la_veterinaria_transparente"
                />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_login"
                android:padding="32dp"
                android:layout_marginTop="64dp"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_logo_container"
                    android:padding="10dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/fenixlogo"
                        android:contentDescription="@string/app_name" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="CREAR CUENTA"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:text="Sistema de Gestión Veterinaria"
                    android:textColor="@color/vet_text_gray"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_nombre_usuario"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Nombre completo"
                    app:boxBackgroundColor="@color/vet_bg_body"
                    app:boxStrokeColor="@color/vet_input_stroke"
                    app:hintTextColor="@color/vet_text_gray"
                    app:helperTextEnabled="true"
                    app:helperText="Tu nombre completo"
                    app:helperTextTextColor="@color/vet_text_gray"
                    app:counterMaxLength="100"
                    app:endIconMode="clear_text"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusBottomEnd="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_edittext_nombre_usuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_telefono"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Teléfono"
                    app:boxBackgroundColor="@color/vet_bg_body"
                    app:boxStrokeColor="@color/vet_input_stroke"
                    app:hintTextColor="@color/vet_text_gray"
                    app:helperTextEnabled="true"
                    app:helperText="Tu numero de telefono"
                    app:helperTextTextColor="@color/vet_text_gray"
                    app:counterMaxLength="17"
                    app:endIconMode="clear_text"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusBottomEnd="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_edittext_telefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_correo"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Correo Electrónico"
                    app:boxBackgroundColor="@color/vet_bg_body"
                    app:boxStrokeColor="@color/vet_input_stroke"
                    app:hintTextColor="@color/vet_text_gray"
                    app:helperTextEnabled="true"
                    app:helperText="Tu correo"
                    app:helperTextTextColor="@color/vet_text_gray"
                    app:counterMaxLength="100"
                    app:endIconMode="clear_text"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusBottomEnd="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_edittext_correo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_direccion"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Dirección"
                    app:boxBackgroundColor="@color/vet_bg_body"
                    app:boxStrokeColor="@color/vet_input_stroke"
                    app:hintTextColor="@color/vet_text_gray"
                    app:helperTextEnabled="true"
                    app:helperText="Tu direccion"
                    app:helperTextTextColor="@color/vet_text_gray"
                    app:counterMaxLength="100"
                    app:endIconMode="clear_text"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusBottomEnd="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_edittext_direccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_password"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Contraseña"
                    app:boxBackgroundColor="@color/vet_bg_body"
                    app:boxStrokeColor="@color/vet_input_stroke"
                    app:hintTextColor="@color/vet_text_gray"
                    app:helperTextEnabled="true"
                    app:helperText="Debe tener al menos 8 caracteres"
                    app:helperTextTextColor="@color/vet_text_gray"
                    app:counterMaxLength="50"
                    app:endIconMode="password_toggle"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusBottomEnd="6dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_edittext_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/vet_text_gray"
                    android:textStyle="italic"
                    android:text="He leido y acepto todos los terminos y condiciones" />

                <Button
                    android:id="@+id/registrarse_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_button_login"
                    android:text="REGISTRARSE"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:letterSpacing="0.03"
                    android:elevation="0dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
